{
  "name": "opex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* run dev",
    "build": "pnpm -r --filter=./apps/* --filter=./packages/* run build",
    "test": "pnpm -r --filter=./apps/* --filter=./packages/* run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "seed": "pnpm --filter @opex/api run seed",
    "eval": "node scripts/eval-noop.mjs",
    "manifest:check": "tsx scripts/manifest-check.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.1",
    "postgres": "^3.4.4",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  }
}
