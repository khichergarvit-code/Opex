# Copy to .env and fill in for local dev / docker compose.
# Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=opex
POSTGRES_PASSWORD=opex_dev_only_change_me
POSTGRES_DB=opex
DATABASE_URL=postgres://opex:opex_dev_only_change_me@localhost:5432/opex

# --- API ---
PORT=3000
SESSION_SECRET=dev_only_change_me_use_a_random_64_byte_value
NODE_ENV=development

# --- Models ---
MODELS_DIR=./models
MANIFEST_PATH=./infra/models/manifest.yaml
# Which model runs where. `docker-llm` starts the bundled CPU model container. Remove it (leave empty)
# when you run the model natively on your GPU: `scripts/run-native-llama.sh --write-env` (or the .ps1 with -WriteEnv)
# edits this file for you. Keep `docker-llm` only if this machine has no GPU (CPU model, slow).
COMPOSE_PROFILES=docker-llm

# Model tier (one vision-language model does chat, images and routing):
#   small    Qwen3-VL-4B, ~3 GB, fastest, fits a 4 GB GPU (RTX 3050) and any Mac   [default]
#   standard Qwen2.5-VL-7B, ~5.5 GB, higher quality, needs an 8 GB+ GPU or a 16 GB Mac
# With `standard` also set LLM_MODEL_FILE=Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf and
# LLM_MMPROJ_FILE=mmproj-Qwen2.5-VL-7B-Instruct-Q8_0.gguf for the bundled container.
LLM_TIER=small
# Context size the model server runs with (the API trims prompts to fit it). Keep in sync with the
# server; scripts/run-native-llama.* print the right value. Empty = the tier's default (8192 / 16384).
LLM_CTX_LEN=

# Model endpoints. Leave empty to use the bundled containers. To use a model served elsewhere
# (a bigger Qwen on another machine, an OpenAI-compatible server, ...), put its base URL here and
# restart the API — nothing else to edit. Internal hosts only (Docker service names, localhost,
# 10.x / 172.16-31.x / 192.168.x, *.local / *.internal); public hosts are refused at boot.
# Externally served models cannot be SHA-256 verified and show as "unverified" in the admin UI.
LLM_MAIN_URL=
LLM_ROUTER_URL=
LLM_VISION_URL=
LLM_EMBED_URL=
# Optional image generation (native GPU server, scripts/run-native-imagegen.*). Leave empty to disable.
LLM_IMAGE_URL=
# Optional reranker: unset = off (document search then judges support by embedding similarity).
LLM_RERANK_URL=

# --- Offline invariants (set on every container, see core.md) ---
DO_NOT_TRACK=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
